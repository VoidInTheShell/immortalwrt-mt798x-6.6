# BPI-R3 Mini + PortalWRT + ModemManager (USB cellular modems).
# Standalone preset; APN, modem device and WAN policy are configured in LuCI.
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r3-mini=y
CONFIG_PACKAGE_luci-theme-kucat=y
# Keep both LuCI navigation branches used by the MM frontend in the image.
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
# CONFIG_FEED_qmodem is not set
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="PortalWRT"
CONFIG_VERSION_NUMBER="24.10"
CONFIG_VERSION_CODE="GLaDOS-R3Mini"
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/24.10-SNAPSHOT"
CONFIG_VERSION_MANUFACTURER="APERTURE SCIENCE"
CONFIG_VERSION_MANUFACTURER_URL="https://www.valvesoftware.com"
CONFIG_VERSION_PRODUCT="APERTURE SCIENCE"
CONFIG_VERSION_HWREV="BPI-R3 Mini"

# One connection manager, with the existing OpenWrt netifd/LuCI integration.
CONFIG_PACKAGE_modemmanager=y
CONFIG_PACKAGE_modemmanager-rpcd=y
CONFIG_PACKAGE_luci-proto-modemmanager=y
CONFIG_MODEMMANAGER_WITH_QMI=y
CONFIG_MODEMMANAGER_WITH_MBIM=y
# Allow root to issue serialized diagnostic AT commands through mmcli.
CONFIG_MODEMMANAGER_WITH_AT_COMMAND_VIA_DBUS=y
CONFIG_LIBQMI_WITH_MBIM_QMUX=y
CONFIG_LIBQMI_COLLECTION_BASIC=y

# RG520N USB QMI/MBIM, plus common USB modem layouts for future replacements.
# The native Key-B slot has USB connectivity, not PCIe lanes.
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_qmi-utils=y
CONFIG_PACKAGE_mbim-utils=y

# Avoid competing managers and overlapping vendor QMI drivers in this preset.
# CONFIG_PACKAGE_luci-app-modem is not set
# CONFIG_PACKAGE_luci-app-qmodem is not set
# CONFIG_PACKAGE_luci-app-qmodem-next is not set
# CONFIG_PACKAGE_qmodem is not set
# CONFIG_PACKAGE_quectel-cm is not set
# CONFIG_PACKAGE_quectel-CM-5G is not set
# CONFIG_PACKAGE_quectel-CM-5G-M is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-fibocom is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-quectel is not set
# CONFIG_PACKAGE_kmod-qmi_wwan_f is not set
# CONFIG_PACKAGE_kmod-qmi_wwan_m is not set
# CONFIG_PACKAGE_kmod-qmi_wwan_q is not set
# CONFIG_PACKAGE_kmod-qmi_wwan_s is not set
