+/* XDP changes the shared RX buffer DMA direction. Include the internal
+ * DMA owner and every running GMAC when rebuilding those buffers. On an
+ * allocation failure, restore the old program and attempt to reopen the
+ * old configuration; leave unrecoverable interfaces administratively down.
+ */
+static int mtk_ppd_xdp_setup(struct mtk_eth *eth, struct bpf_prog *prog)
+{
+	struct bpf_prog *old_prog = rtnl_dereference(eth->prog);
+	unsigned long restart = 0;
+	bool ppd_restart = netif_running(eth->ppd);
+	int i, attempt, err = 0, first_err = 0;
+
+	for (i = 0; i < MTK_MAX_DEVS; i++)
+		if (eth->netdev[i] && netif_running(eth->netdev[i]))
+			restart |= BIT(i);
+
+	for (attempt = 0; attempt < 2; attempt++) {
+		if (ppd_restart)
+			mtk_ppd_stop(eth->ppd);
+		for (i = 0; i < MTK_MAX_DEVS; i++)
+			if (restart & BIT(i))
+				mtk_stop(eth->netdev[i]);
+		rcu_assign_pointer(eth->prog, attempt ? old_prog : prog);
+		err = 0;
+		for (i = 0; i < MTK_MAX_DEVS; i++) {
+			int ret;
+
+			if (!(restart & BIT(i)))
+				continue;
+			ret = mtk_open(eth->netdev[i]);
+			if (ret) {
+				err = ret;
+				if (attempt)
+					dev_close(eth->netdev[i]);
+			}
+		}
+		if (ppd_restart) {
+			int ret = mtk_ppd_open(eth->ppd);
+
+			if (ret) {
+				err = ret;
+				if (attempt)
+					dev_close(eth->ppd);
+			}
+		}
+		if (!attempt)
+			first_err = err;
+		if (!err)
+			break;
+	}
+	if (!first_err && old_prog)
+		bpf_prog_put(old_prog);
+	return first_err;
+}
