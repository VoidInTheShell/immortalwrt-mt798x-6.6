+static int mtk_stop(struct net_device *dev)
+{
+	struct mtk_mac *mac = netdev_priv(dev);
+
+	/* A failed reset/reopen did not acquire another DMA reference. */
+	if (!mac->dma_up)
+		return 0;
+	mac->dma_up = false;
+	phylink_stop(mac->phylink);
+	netif_tx_disable(dev);
+	phylink_disconnect_phy(mac->phylink);
+	return mtk_dma_close(mac->hw);
+}
+
+static int mtk_ppd_open(struct net_device *dev)
+{
+	struct mtk_mac *mac = netdev_priv(dev);
+	int err = mtk_dma_open(mac->hw);
+
+	if (err)
+		return err;
+	mac->dma_up = true;
+	netif_carrier_on(dev);
+	netif_start_queue(dev);
+	return 0;
+}
+
+static int mtk_ppd_stop(struct net_device *dev)
+{
+	struct mtk_mac *mac = netdev_priv(dev);
+
+	netif_carrier_off(dev);
+	netif_tx_disable(dev);
+	if (!mac->dma_up)
+		return 0;
+	mac->dma_up = false;
+	return mtk_dma_close(mac->hw);
+}
