+/* This port is internal to NETSYS. It has no PHY, MAC register bank, IP
+ * address or bridge membership. A normal qdisc supplies backpressure to
+ * the shared DMA ring, independently of the two physical carrier states.
+ */
+static int mtk_add_ppd(struct mtk_eth *eth)
+{
+	struct net_device *dev;
+	struct mtk_mac *mac;
+	int err;
+
+	if (!IS_ENABLED(CONFIG_NET_MEDIATEK_HNAT) ||
+	    !of_property_read_bool(eth->dev->of_node, "mediatek,hnat-ppd"))
+		return 0;
+	if (eth->soc->version != 2 || !MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA))
+		return -EINVAL;
+
+	dev = alloc_etherdev(sizeof(*mac));
+	if (!dev)
+		return -ENOMEM;
+	strscpy(dev->name, "ppe0", IFNAMSIZ);
+	mac = netdev_priv(dev);
+	mac->id = MTK_PPD_ID;
+	mac->hw = eth;
+	dev->netdev_ops = &mtk_ppd_netdev_ops;
+	dev->pcpu_stat_type = NETDEV_PCPU_STAT_TSTATS;
+	dev->watchdog_timeo = 5 * HZ;
+	dev->flags |= IFF_NOARP;
+	dev->priv_flags |= IFF_DONT_BRIDGE | IFF_NO_ADDRCONF;
+	dev->hw_features = eth->soc->hw_features;
+	dev->features |= dev->hw_features;
+	dev->vlan_features = dev->hw_features & ~NETIF_F_HW_VLAN_CTAG_TX;
+	dev->max_mtu = mtk_get_max_mtu(eth, PHY_INTERFACE_MODE_2500BASEX);
+	eth_hw_addr_random(dev);
+	SET_NETDEV_DEV(dev, eth->dev);
+	eth->ppd = dev;
+	/* RTNL prevents netifd from closing/reopening the endpoint between
+	 * registration and the initial DMA reference acquisition.
+	 */
+	rtnl_lock();
+	err = register_netdevice(dev);
+	if (!err)
+		err = dev_open(dev, NULL);
+	if (err && dev->reg_state == NETREG_REGISTERED)
+		unregister_netdevice(dev);
+	rtnl_unlock();
+	if (err) {
+		eth->ppd = NULL;
+		free_netdev(dev);
+		return err;
+	}
+	dev_info(eth->dev, "ppe0: independent HNAT DMA endpoint\n");
+	return 0;
+}
