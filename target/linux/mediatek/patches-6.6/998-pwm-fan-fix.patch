Subject: mediatek: pwm-fan: preserve thermal control and scope initial zero to DT

Keep the normal thermal cooling-device registration used by the BPI-R3 Mini.
Boards whose fan controller produces an unwanted pulse during probe can opt in
to an initial zero output with the mediatek,initial-pwm-zero device-tree
property.

--- a/drivers/hwmon/pwm-fan.c
+++ b/drivers/hwmon/pwm-fan.c
@@ -627,6 +627,14 @@
 		return ret;
 
 	ctx->pwm_fan_state = ctx->pwm_fan_max_state;
+	if (of_property_read_bool(dev->of_node, "mediatek,initial-pwm-zero")) {
+		ret = set_pwm(ctx, 0);
+		if (ret)
+			return ret;
+
+		ctx->pwm_fan_state = 0;
+	}
+
 	if (IS_ENABLED(CONFIG_THERMAL)) {
 		cdev = devm_thermal_of_cooling_device_register(dev,
 			dev->of_node, "pwm-fan", ctx, &pwm_fan_cooling_ops);
