# BPI-R3 Mini: ModemManager-only USB and optional PCIe LTE/5G modem profile
#
# This is an auditable package/Kconfig fragment, kept outside .config.  Apply it
# after selecting the BPI-R3 Mini target and run the normal configuration
# resolver.  The board's NGFF/Key-B modem path is USB in the current DTS; see
# modem-driver-compatibility.md for the PCIe/MHI decision and the driver matrix.
#
# ModemManager is the only automatic modem manager.  qmi-utils and mbim-utils
# below are diagnostic clients, not competing connection managers.

# ModemManager, its LuCI protocol and the rpcd read-only interface
CONFIG_PACKAGE_modemmanager=y
CONFIG_PACKAGE_modemmanager-rpcd=y
CONFIG_PACKAGE_luci-proto-modemmanager=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-app-mmconfig=y
CONFIG_PACKAGE_luci-app-sms-manager=y

# MM protocol support.  The package enables all upstream built-in plugins
# (-Dbuiltin_plugins=true); individual MM plugin CONFIG_PACKAGE symbols do not
# exist in this tree and must not be invented here.
CONFIG_MODEMMANAGER_WITH_AT_COMMAND_VIA_DBUS=y
CONFIG_MODEMMANAGER_WITH_MBIM=y
CONFIG_MODEMMANAGER_WITH_QMI=y
CONFIG_MODEMMANAGER_WITH_QRTR=y

# Full userspace protocol collections and standalone diagnostics
CONFIG_PACKAGE_libqmi=y
CONFIG_LIBQMI_COLLECTION_FULL=y
CONFIG_LIBQMI_WITH_MBIM_QMUX=y
CONFIG_LIBQMI_WITH_QRTR_GLIB=y
CONFIG_PACKAGE_libmbim=y
CONFIG_PACKAGE_libqrtr-glib=y
CONFIG_PACKAGE_qmi-utils=y
CONFIG_PACKAGE_mbim-utils=y

# MM runtime and OpenWrt integration.  ppp is retained because the installed
# netifd modemmanager protocol exits when pppd is absent, including for a DHCP
# bearer.  rpcd/lua/cjson are needed by modemmanager-rpcd; procd/netifd are used
# by the init script and protocol script; luci-base supplies the LuCI runtime.
CONFIG_PACKAGE_glib2=y
CONFIG_PACKAGE_dbus=y
CONFIG_PACKAGE_libdbus=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_lua-cjson=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_luci-base=y

# This is the small libudev provider already used by the target.  ModemManager
# itself is built with -Dudev=false and does not need libgudev; retain this
# provider for other packages, and do not select libudev/eudev/udev alongside it.
CONFIG_PACKAGE_libudev-zero=y

# USB host/control plumbing
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-acm=y

# Mainline USB modem data paths.  These are the modem-oriented minidrivers in
# usb.mk; cdc-ether is kept because the kernel table names several mobile
# broadband modules, while cdc-eem/cdc-subset are generic links and are omitted.
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-hso=y
CONFIG_PACKAGE_kmod-usb-net-kalmia=y

# HSO's kernel Kconfig depends on RFKILL and TTY.  Enabling the small RFKILL
# package makes the legacy Option HSO module a real, buildable choice rather
# than a package selector that silently loses its kernel dependency.
CONFIG_USE_RFKILL=y
CONFIG_PACKAGE_kmod-input-core=y
CONFIG_PACKAGE_kmod-rfkill=y

# Mainline USB serial modem paths.  usbserial is the core and usb_wwan is a
# hidden dependency selected by option/qcserial.  The generic serial Kconfig
# item is a bool in the kernel and is already enabled by target/linux/generic;
# there is no kmod-usb-serial-generic package/IPK.
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-serial-ipw=y
CONFIG_PACKAGE_kmod-usb-serial-ti-usb=y
CONFIG_PACKAGE_ti-3410-firmware=y
CONFIG_PACKAGE_ti-5052-firmware=y
# Kernel CONFIG_USB_SERIAL_GENERIC=y comes from target/linux/generic/config-6.6;
# it is not an OpenWrt top-level Kconfig symbol and must not be put in .config.

# Storage-mode devices may need the OpenWrt mode switch helper before their
# modem interfaces appear.
CONFIG_PACKAGE_usb-modeswitch=y

# One coherent QMI WWAN implementation.  The vendor modules below register
# separate qmi_wwan_f/qmi_wwan_q drivers against overlapping USB interfaces;
# their package metadata does not declare Conflicts, so leave both disabled.
# Missing vendor-only IDs and raw-IP/QMAP behavior are documented in the report.
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-fibocom is not set
# CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-quectel is not set

# Keep ModemManager as the single connection manager and UI protocol.
# CONFIG_PACKAGE_luci-proto-qmi is not set
# CONFIG_PACKAGE_luci-proto-mbim is not set
# CONFIG_PACKAGE_luci-proto-quectel is not set
# CONFIG_PACKAGE_uqmi is not set
# CONFIG_PACKAGE_umbim is not set
# CONFIG_PACKAGE_comgt is not set
# CONFIG_PACKAGE_quectel-cm is not set
# CONFIG_PACKAGE_qmodem is not set
# CONFIG_PACKAGE_luci-app-qmodem is not set
# CONFIG_PACKAGE_luci-app-modem is not set
# CONFIG_PACKAGE_luci-app-modemband is not set

# These are unrelated generic USB links or phone tethering, not required for
# MM-managed modem operation.  CDC-phonet and VL600 have kernel Kconfig items
# in 6.6 but no corresponding package definition in this tree.
# CONFIG_PACKAGE_kmod-usb-net-cdc-eem is not set
# CONFIG_PACKAGE_kmod-usb-net-cdc-subset is not set
# CONFIG_PACKAGE_kmod-usb-net-ipheth is not set
# CONFIG_PACKAGE_kmod-usb-serial-simple is not set

# Optional mainline PCIe WWAN coverage: endpoints enumerate automatically.
# This requires an electrically suitable PCIe/M-Key modem adapter; it does not
# turn the board's USB Key-B modem connector into a PCIe connector. Modules
# match device IDs/channels and remain inactive when matching hardware is absent.
# See modem-extra-drivers.md for firmware, MSI, DMA and adapter limitations.
CONFIG_PACKAGE_kmod-wwan=y
CONFIG_PACKAGE_kmod-mhi-bus=y
CONFIG_PACKAGE_kmod-mhi-pci-generic=y
CONFIG_PACKAGE_kmod-mhi-net=y
CONFIG_PACKAGE_kmod-mhi-wwan-ctrl=y
CONFIG_PACKAGE_kmod-mhi-wwan-mbim=y
CONFIG_PACKAGE_kmod-qrtr=y
CONFIG_PACKAGE_kmod-qrtr-mhi=y
CONFIG_PACKAGE_kmod-mtk-t7xx=y
CONFIG_PACKAGE_kmod-iosm=y
