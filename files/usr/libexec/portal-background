#!/bin/sh
# Durable source is kept outside package-owned /www. Restore it even when the
# URL is unchanged, the theme is reinstalled, or the router has no Internet.
# ROOT is only for the offline regression harness; production leaves it empty.
ROOT=${PORTAL_TEST_ROOT:-}
if [ "$1" = watch ]; then
    while :; do "$0"; sleep 60; done
fi
. "$ROOT/etc/portalwrt.conf"
[ -n "$PORTAL_THEME_BG_URL" ] || exit 0
cache="$ROOT/etc/portalwrt-background"
mkdir -p "$ROOT/var/lock" "$cache" || exit 1
exec 9>"$ROOT/var/lock/portal-background.lock"
flock -n 9 || exit 0
image="$cache/download.$$"
trap 'rm -f "$image"' EXIT
trap 'exit 1' HUP INT TERM
valid_image() {
    [ -s "$1" ] || return 1
    case "$(hexdump -v -n 8 -e '8/1 "%02x"' "$1")" in
        ffd8ff*|89504e470d0a1a0a) return 0 ;; *) return 1 ;;
    esac
}
publish() {
    valid_image "$cache/image" || return 1
    for target in luci-static/argon/img/bg1.jpg luci-static/kucat/img/bg1.jpg luci-static/resources/background/portal.jpg; do
        dest="$ROOT/www/$target"
        mkdir -p "${dest%/*}" || return 1
        cmp -s "$cache/image" "$dest" && continue
        cp "$cache/image" "$dest.new" && mv "$dest.new" "$dest" || return 1
    done
}
# Migrate an already-downloaded custom wallpaper from the previous layout.
if ! valid_image "$cache/image" && [ -s "$ROOT/etc/portalwrt-background.url" ] &&
    valid_image "$ROOT/www/luci-static/resources/background/portal.jpg"; then
    cp "$ROOT/www/luci-static/resources/background/portal.jpg" "$cache/image" || exit 1
    cp "$ROOT/etc/portalwrt-background.url" "$cache/url" || exit 1
fi
publish || :
if valid_image "$cache/image" && [ "$(cat "$cache/url" 2>/dev/null)" = "$PORTAL_THEME_BG_URL" ]; then
    publish
    exit $?
fi
if wget -q -T 15 -O "$image" "$PORTAL_THEME_BG_URL" && valid_image "$image"; then
    mv "$image" "$cache/image" || exit 1
    printf '%s\n' "$PORTAL_THEME_BG_URL" > "$cache/url.new"
    mv "$cache/url.new" "$cache/url" || exit 1
    publish || exit 1
    logger -t portal-background 'Custom wallpaper restored for Argon and KuCat'
    exit 0
fi
logger -t portal-background 'Wallpaper download failed; retained cached/bundled image, will retry'
exit 1
