diff --git a/net/daed/files/daed.init b/net/daed/files/daed.init
index baa72884..f13a5abe 100644
--- a/net/daed/files/daed.init
+++ b/net/daed/files/daed.init
@@ -3,17 +3,43 @@
 
 USE_PROCD=1
 START=99
+STOP=10
 
 CONF="daed"
 PROG="/usr/bin/daed"
 LOG="/var/log/daed/daed.log"
 
+service_name() {
+	basename "${basescript:-$initscript}"
+}
+
+add_interface_trigger() {
+	local network="$1"
+
+	[ -n "$network" ] || return 0
+	procd_add_interface_trigger "interface.*" "$network" "/etc/init.d/$(service_name)" reload
+}
+
 start_service() {
 	config_load "$CONF"
 
 	local enabled
 	config_get_bool enabled "config" "enabled" "0"
-	[ "$enabled" -eq "1" ] || return 1
+	[ "$enabled" = "1" ] || return 0
+	if [ "$(uci -q get qosmate.global.enabled)" = "1" ]; then
+		logger -t daed "cannot start while QoSmate owns the ingress queues; disable QoSmate first"
+		return 1
+	fi
+
+	[ -x "$PROG" ] || {
+		logger -t daed "cannot start: $PROG is missing or not executable"
+		return 1
+	}
+
+	mkdir -p "${LOG%/*}" || {
+		logger -t daed "cannot start: unable to create log directory"
+		return 1
+	}
 
 	local listen_addr log_maxbackups log_maxsize
 	config_get listen_addr "config" "listen_addr" "0.0.0.0:2023"
@@ -37,10 +63,30 @@ start_service() {
 	procd_close_instance
 }
 
+reload_service() {
+	config_load "$CONF"
+
+	# daed has no separate reload command. Always remove the old procd
+	# instance before rebuilding it so changing enabled=0 cannot leave a
+	# running daemon behind.
+	stop_service
+	procd_kill "$(service_name)" "$CONF"
+	rc_procd start_service
+}
+
 stop_service() {
-	rm -f "$LOG"
+	# procd terminates this service's instance. Keep its log for diagnostics.
+	:
 }
 
 service_triggers() {
+	config_load "$CONF"
 	procd_add_reload_trigger "$CONF"
+
+	local enabled hotplug
+	config_get_bool enabled "config" "enabled" "0"
+	config_get_bool hotplug "config" "hotplug" "0"
+	[ "$enabled" = "1" ] && [ "$hotplug" = "1" ] || return 0
+
+	config_list_foreach "config" "hotplug_network" add_interface_trigger
 }
