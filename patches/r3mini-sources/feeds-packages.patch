+}
+
+ensure_identity() {
+	local configured_secret secret_tmp public_tmp
+
+	configured_secret="${secret}"
+	if [ -z "${secret}" ] && [ -s "${CONFIG_PATH}/identity.secret" ]; then
+		secret="$(cat "${CONFIG_PATH}/identity.secret")"
+	fi
+
+	if [ -z "${secret}" ]; then
+		echo -n "Generating ZeroTier identity - please wait... "
+		secret="$("${IDTOOL}" generate)" || return 1
+		echo "done."
+	fi
+
+	[ -n "${secret}" ] || return 1
+	# Keep the private key and its matching public key together.  Do not leave
+	# a stale identity.public behind after a restored or newly generated secret.
+	umask 077
+	secret_tmp="$(mktemp "${CONFIG_PATH}/.identity.secret.XXXXXX")" || return 1
+	public_tmp="$(mktemp "${CONFIG_PATH}/.identity.public.XXXXXX")" || {
+		rm -f "${secret_tmp}"
+		return 1
+	}
+	printf '%s\n' "${secret}" > "${secret_tmp}"
+	if ! "${IDTOOL}" validate "${secret_tmp}" >/dev/null 2>&1; then
+		echo "Invalid ZeroTier client secret"
+		rm -f "${secret_tmp}" "${public_tmp}"
+		return 1
+	fi
+	if ! "${IDTOOL}" getpublic "${secret_tmp}" > "${public_tmp}" || [ ! -s "${public_tmp}" ]; then
+		echo "Unable to derive ZeroTier public identity"
+		rm -f "${secret_tmp}" "${public_tmp}"
+		return 1
+	fi
+	chmod 600 "${secret_tmp}"
+	chmod 644 "${public_tmp}"
+	mv -f "${secret_tmp}" "${CONFIG_PATH}/identity.secret"
+	mv -f "${public_tmp}" "${CONFIG_PATH}/identity.public"
+
+	if [ "${configured_secret}" != "${secret}" ]; then
+		uci set zerotier.global.secret="${secret}"
+		uci commit zerotier
+	fi
+}
 
