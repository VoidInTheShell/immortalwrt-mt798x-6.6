+# Keep the alpha variant on the same isolated SDK as mihomo-meta.
+GO_PKG_BUILD_VARS += \
+	PATH="$(STAGING_DIR_HOSTPKG)/lib/go-1.26.8/bin:$$$$PATH"
+
 define Package/mihomo-alpha
   SECTION:=net
   CATEGORY:=Network
@@ -37,7 +41,7 @@ define Package/mihomo-alpha
   URL:=https://wiki.metacubex.one
   DEPENDS:=$(GO_ARCH_DEPENDS) +ca-bundle +ip-full +kmod-inet-diag +kmod-tun
