-  CONFLICTS:=mihomo-meta
+  # Mutual exclusion is declared by mihomo-meta to avoid a Kconfig cycle.
   VARIANT:=alpha
   ALTERNATIVES:=\
     300:/usr/bin/mihomo:/usr/libexec/mihomo
