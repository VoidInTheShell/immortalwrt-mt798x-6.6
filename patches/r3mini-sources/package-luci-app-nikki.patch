diff --git a/mihomo-alpha/Makefile b/mihomo-alpha/Makefile
index 53caa93..7be1e45 100644
--- a/mihomo-alpha/Makefile
+++ b/mihomo-alpha/Makefile
@@ -13,7 +13,7 @@ PKG_MIRROR_HASH:=e92f6783831a2b49dd376ee4af7df35cdac0151c7333515616cc14c841eb68d
 PKG_LICENSE:=GPL3.0+
 PKG_MAINTAINER:=Joseph Mory <morytyann@gmail.com>
 
-PKG_BUILD_DEPENDS:=golang/host
+PKG_BUILD_DEPENDS:=golang-host-compat/host
 PKG_BUILD_PARALLEL:=1
 PKG_BUILD_FLAGS:=no-mips16
 
@@ -30,6 +30,10 @@ GO_PKG_INSTALL_BIN_PATH:=/usr/libexec
 include $(INCLUDE_DIR)/package.mk
