-if [ -z "$DEV" ]; then
-	exit 0
+# Read inbox state through MM only. Empty/default configuration is inert.
+[ "$(uci -q get sms_manager.@sms_manager[0].lednotify)" = "1" ] || exit 0
+device=$(uci -q get sms_manager.@sms_manager[0].readport)
+index=${device##*/}
+case "$index" in ''|*[!0-9]*) exit 0 ;; esac
+led=$(uci -q get sms_manager.@sms_manager[0].smsled)
+case "$led" in ''|*[!A-Za-z0-9_:.-]*|.|..) exit 0 ;; esac
+directory="/sys/class/leds/$led"
+[ -w "$directory/trigger" ] || exit 0
+baseline=$(uci -q get sms_manager.@sms_manager[0].sms_count)
+case "$baseline" in ''|*[!0-9]*) baseline=0 ;; esac
+baseline=$(printf '%s' "$baseline" | sed 's/^0*//')
+baseline=${baseline:-0}
+[ "${#baseline}" -le 9 ] || exit 0
+listing=$(mmcli -m "$index" --messaging-list-sms 2>/dev/null) || exit 0
+count=$(printf '%s\n' "$listing" | grep -c '/SMS/')
+if [ "$count" -gt "$baseline" ]; then
+	printf '%s\n' timer > "$directory/trigger"
+	[ -w "$directory/delay_on" ] && printf '%s\n' 1000 > "$directory/delay_on"
+	[ -w "$directory/delay_off" ] && printf '%s\n' 5000 > "$directory/delay_off"
 fi
