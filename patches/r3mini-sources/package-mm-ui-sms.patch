-
-	exit 0
-fi
-
-if [ $SMS -gt $SMSD ]; then
-
-echo timer > $LEDT
-echo $TMOFF > $LEDOFF
-echo $TMON > $LEDON
-exit 0
-
-fi
-
-
 exit 0
