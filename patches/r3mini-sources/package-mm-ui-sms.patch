diff --git a/luci-app-sms-manager/root/usr/libexec/rpcd/sms_manager_send b/luci-app-sms-manager/root/usr/libexec/rpcd/sms_manager_send
new file mode 100755
index 0000000..d6c24d4
--- /dev/null
+++ b/luci-app-sms-manager/root/usr/libexec/rpcd/sms_manager_send
@@ -0,0 +1,39 @@
+#!/bin/sh
+# MM's key=value parser cannot escape both kinds of quotes. Pass UTF-8 text
+# through a private temporary file using the supported MM 1.22 CLI option.
+. "${JSHN_LIB:-/usr/share/libubox/jshn.sh}"
+
+reply() {
+	json_init
+	json_add_boolean success "$1"
+	json_add_string message "$2"
+	json_dump
+}
+
+case "$1:$2" in
+	list:*) echo '{"send":{"modem":"str","number":"str","text":"str"}}' ;;
+	call:send)
+		IFS= read -r request
+		json_load "$request" || { reply 0 'Invalid request'; exit 0; }
+		json_get_var modem modem
+		json_get_var number number
+		json_get_var message text
+		case "$modem" in ''|*[!0-9]*) reply 0 'Invalid modem index'; exit 0 ;; esac
+		[ "${#modem}" -le 5 ] || { reply 0 'Invalid modem index'; exit 0; }
+		digits=${number#+}
+		case "$digits" in ''|*[!0-9]*) reply 0 'Invalid phone number'; exit 0 ;; esac
+		[ "${#digits}" -le 32 ] && [ -n "$message" ] || { reply 0 'Invalid SMS'; exit 0; }
+		umask 077
+		text_file=$(mktemp /tmp/sms-manager-text.XXXXXX) || { reply 0 'Cannot create message file'; exit 0; }
+		trap 'rm -f "$text_file"' EXIT
+		trap 'exit 1' HUP INT TERM
+		printf '%s' "$message" > "$text_file"
+		result=$(mmcli -m "$modem" --messaging-create-sms="number=$number" \
+			--messaging-create-sms-with-text="$text_file" 2>&1)
+		if [ "$?" -ne 0 ]; then reply 0 "$result"; exit 0; fi
+		index=$(printf '%s\n' "$result" | sed -n 's|.*/SMS/\([0-9][0-9]*\).*|\1|p')
+		case "$index" in ''|*[!0-9]*) reply 0 'ModemManager did not return an SMS object'; exit 0 ;; esac
+		result=$(mmcli -s "$index" --send 2>&1)
+		if [ "$?" -eq 0 ]; then reply 1 "$result"; else reply 0 "$result"; fi
+		;;
+esac
diff --git a/tests/test-sms-manager.py b/tests/test-sms-manager.py
new file mode 100644
index 0000000..ebfad85
--- /dev/null
+++ b/tests/test-sms-manager.py
@@ -0,0 +1,96 @@
+#!/usr/bin/env python3
+"""Mock MM calls; never sends a real SMS or opens a modem device."""
+import fnmatch
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1] / 'luci-app-sms-manager'
+
+
+class SMSTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.path = Path(self.tmp.name)
+        self.env = dict(os.environ, PATH=str(self.path) + os.pathsep + os.environ['PATH'],
+                        MM_TEST_DIR=str(self.path))
+        mock = self.path / 'mmcli'
+        mock.write_text('''#!/usr/bin/env python3
+import json, os, pathlib, sys
+root = pathlib.Path(os.environ['MM_TEST_DIR'])
+with (root / 'calls').open('a') as f: f.write(json.dumps(sys.argv[1:]) + '\\n')
+for arg in sys.argv[1:]:
+    if arg.startswith('--messaging-create-sms-with-text='):
+        p = pathlib.Path(arg.split('=', 1)[1])
+        assert p.stat().st_mode & 0o777 == 0o600
+        (root / 'text').write_bytes(p.read_bytes())
+        (root / 'filename').write_text(str(p))
+        print('Successfully created SMS: /org/freedesktop/ModemManager1/SMS/9')
+        sys.exit(0)
+if '--send' in sys.argv:
+    if os.environ.get('MM_TEST_FAIL'): print('mock send failure'); sys.exit(1)
+    print('successfully sent the SMS')
+else: sys.exit(2)
+''')
+        mock.chmod(0o755)
+        jshn = self.path / 'jshn.sh'
+        jshn.write_text('''json_load() { MM_TEST_INPUT="$1"; }
+json_get_var() {
+    value=$(printf '%s' "$MM_TEST_INPUT" | python3 -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1], ""), end="")' "$2")
+    case "$1" in modem) modem="$value" ;; number) number="$value" ;; message) message="$value" ;; esac
+}
+json_init() { MM_TEST_SUCCESS=0; MM_TEST_MESSAGE=''; }
+json_add_boolean() { MM_TEST_SUCCESS="$2"; }
+json_add_string() { MM_TEST_MESSAGE="$2"; }
+json_dump() {
+    export MM_TEST_SUCCESS MM_TEST_MESSAGE
+    python3 -c 'import json,os; print(json.dumps({"success": bool(int(os.environ["MM_TEST_SUCCESS"])), "message": os.environ["MM_TEST_MESSAGE"]}))'
+}
+''')
+        self.env['JSHN_LIB'] = str(jshn)
+
+    def send(self, **changes):
+        request = dict(modem='0', number='+8613800000000', text='test')
+        request.update(changes)
+        result = subprocess.run(['sh', str(ROOT / 'root/usr/libexec/rpcd/sms_manager_send'), 'call', 'send'],
+                                input=json.dumps(request) + '\n', text=True, capture_output=True, env=self.env)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        return json.loads(result.stdout)
+
+    def test_exact_unicode_punctuation_and_private_file(self):
+        message = "中文, spaces 'single' \"double\" \\ slash\nsecond line $(do-not-run)"
+        self.assertTrue(self.send(text=message)['success'])
+        self.assertEqual((self.path / 'text').read_text(), message)
+        calls = [json.loads(line) for line in (self.path / 'calls').read_text().splitlines()]
+        self.assertEqual(len(calls), 2)
+        self.assertEqual(calls[1], ['-s', '9', '--send'])
+        self.assertFalse(Path((self.path / 'filename').read_text()).exists())
+
+    def test_invalid_input_never_calls_mm(self):
+        for changes in ({'modem': '0 --reset'}, {'number': '+123,text=bad'}, {'text': ''}):
+            self.assertFalse(self.send(**changes)['success'])
+        self.assertFalse((self.path / 'calls').exists())
+
+    def test_send_failure_reported_and_file_removed(self):
+        self.env['MM_TEST_FAIL'] = '1'
+        response = self.send()
+        self.assertFalse(response['success'])
+        self.assertIn('mock send failure', response['message'])
+        self.assertFalse(Path((self.path / 'filename').read_text()).exists())
+
+    def test_read_acl_cannot_send_or_execute_shell(self):
+        acl = json.loads((ROOT / 'root/usr/share/rpcd/acl.d/luci-app-sms-manager.json').read_text())['luci-app-sms-manager']
+        patterns = [p for p, rights in acl['read']['file'].items() if 'exec' in rights]
+        for cmd in ('/bin/sh', '/usr/bin/mmcli -m 0 --reset', '/usr/bin/mmcli -s 1 --send',
+                    '/usr/bin/mmcli -m 0 --command=ATZ'):
+            self.assertFalse(any(fnmatch.fnmatchcase(cmd, p) for p in patterns), cmd)
+        self.assertNotIn('sms_manager_send', acl['read']['ubus'])
+        self.assertIn('send', acl['write']['ubus']['sms_manager_send'])
+
+
+if __name__ == '__main__':
+    unittest.main()
