@@ -0,0 +1,22 @@
+#!/bin/sh
+
+# QoSmate is shipped disabled.  Keep hotplug passive until the user explicitly
+# enables global.enabled; this avoids changing qdiscs or HNAT on first boot.
+[ "$ACTION" = "ifup" ] || exit 0
+[ -n "$DEVICE" ] || exit 0
+
+. /lib/functions.sh
+config_load qosmate 2>/dev/null || exit 0
+
+config_get qosmate_enabled global enabled 0
+[ "$qosmate_enabled" = "1" ] || exit 0
+
+# Only react to the configured WAN.  INTERFACE is normally the logical name
+# (wan), while DEVICE is normally the physical name (eth1, pppoe-wan, ...).
+config_get qosmate_wan settings WAN ""
+[ "$INTERFACE" = "wan" ] || [ "$INTERFACE" = "$qosmate_wan" ] || \
+	[ "$DEVICE" = "$qosmate_wan" ] || exit 0
+
+logger -t qosmate "Reloading qosmate after $ACTION of $INTERFACE ($DEVICE)"
+/etc/init.d/qosmate enabled || /etc/init.d/qosmate enable
+/etc/init.d/qosmate restart
