+# Use the standard LuCI installer exactly once. Arrange the prepared views in
+# the namespace referenced by menu.d; root/ also installs both executable RPCs.
+define Build/Prepare/luci-app-qosmate
+	mkdir -p $(PKG_BUILD_DIR)/htdocs/luci-static/resources/view/qosmate
+	mv $(PKG_BUILD_DIR)/htdocs/luci-static/resources/view/*.js $(PKG_BUILD_DIR)/htdocs/luci-static/resources/view/qosmate/
+	chmod 0755 $(PKG_BUILD_DIR)/root/usr/libexec/rpcd/luci.qosmate*
+endef
+
+include $(TOPDIR)/feeds/luci/luci.mk
+
+# call BuildPackage - OpenWrt metadata scan marker; luci.mk expands it once.
