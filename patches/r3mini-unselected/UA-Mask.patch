@@ -1,6 +1,10 @@
+UAMASK_PACKAGE_MAKEFILE:=$(lastword $(MAKEFILE_LIST))
 include $(TOPDIR)/rules.mk
 
-PACKAGE_DIR:=$(abspath $(dir $(lastword $(MAKEFILE_LIST))))
+# Capture this file before rules.mk appends its own include files to
