#!/bin/sh /etc/rc.common

START=95
STOP=15

USE_PROCD=1
NAME=mtkhqos
PROG=/sbin/mtkhqos

start_service() {
	procd_open_instance
	# mtkhqos applies kernel state and exits.  Deliberately omit respawn: it is
	# a one-shot configuration command, not a long-running daemon.
	procd_set_param command "$PROG"
	procd_close_instance
}

stop_service() {
	"$PROG" stop
}

reload_service() {
	stop_service
	start_service
}

service_triggers() {
	procd_add_reload_trigger "mtkhqos"
}
